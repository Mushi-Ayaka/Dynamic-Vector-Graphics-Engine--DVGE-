{
  "name": "dv-web-graphics-engine",
  "version": "4.1.5",
  "main": "dist-electron/main.js",
  "description": "Professional Dynamic Vector Graphics Engine for Broadcast Animation",
  "author": "Jonatan Baron",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint src electron --ext ts,tsx"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/paths": "^4.0.0",
    "@remotion/player": "^4.0.450",
    "@remotion/renderer": "^4.0.0",
    "lucide-react": "^1.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.jonatanbaron.dvremotionengine",
    "productName": "Dynamic Vector Graphics Engine (DVGE)",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "**/*",
      "!**/.cache",
      "!**/node_modules/.cache",
      "!src",
      "src/remotion"
    ],
    "icon": "public/icon_highlight.png",
    "win": {
      "icon": "public/icon_highlight.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "EULA.txt",
      "artifactName": "DVGE-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "**/*ffmpeg*",
      "**/@remotion/compositor-*",
      "**/@esbuild/**/*",
      "**/esbuild.exe",
      "src/remotion/**/*"
    ]
  }
}
